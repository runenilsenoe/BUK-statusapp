@page "/people"
@rendermode InteractiveServer
@using BukStatus.Core.People
@inject PersonService Service
<PageTitle>Personer · BUK Status</PageTitle>
<h1>Personer</h1>

@if (error is not null) { <p role="alert" class="alert">@error</p> }
@if (people is not null)
{
    <label>Søk etter navn eller person-ID <input type="search" @bind="search" @bind:event="oninput" disabled="@busy" /></label>
    <p>@Filtered.Count() av @people.Count personer</p>
    <div class="table-wrap"><table>
        <thead><tr><th aria-sort="@SortDirection(PersonSort.Name)"><button type="button" class="sort-header" @onclick="() => SortBy(PersonSort.Name)">Navn @SortArrow(PersonSort.Name)</button></th><th>Alder</th><th>Person-ID</th><th aria-sort="@SortDirection(PersonSort.TotalTarget)"><button type="button" class="sort-header" @onclick="() => SortBy(PersonSort.TotalTarget)">Totalt bidragsmål (BUK, kr) @SortArrow(PersonSort.TotalTarget)</button></th>
            <th aria-sort="@SortDirection(PersonSort.TotalContribution)"><button type="button" class="sort-header" @onclick="() => SortBy(PersonSort.TotalContribution)">Totalt bidrag (BUK, kr) @SortArrow(PersonSort.TotalContribution)</button></th>
            <th aria-sort="@SortDirection(PersonSort.SamvirkGetOnTrack)"><button type="button" class="sort-header" @onclick="() => SortBy(PersonSort.SamvirkGetOnTrack)">Get on track (Samvirk, kr) @SortArrow(PersonSort.SamvirkGetOnTrack)</button></th>
            <th>Aksjon</th><th>MyShare</th><th>Ønske</th><th>Notat</th><th></th></tr></thead>
        <tbody>@foreach (var person in Filtered)
        {
            <tr @key="person.Member.Id"><th scope="row">@person.Member.DisplayName</th><td>@(person.Member.Age(DateOnly.FromDateTime(DateTime.Today))?.ToString() ?? "–")</td><td>@person.Member.Id</td><td class="amount">@Money(person.TotalTarget)</td><td class="amount">@Money(person.TotalContribution)</td><td class="amount" title="@(person.SamvirkSnapshotDate is { } exportDate ? $"Samvirk per {exportDate:dd.MM.yyyy}" : null)">@Money(person.SamvirkGetOnTrack)</td><td>@(person.FollowUp.ExcludedFromCampaign ? "Teller ikke med" : "Teller med")</td><td>@(person.MyshareCountedInAksjon is { } counted ? (counted ? "Teller med" : "Teller ikke med") : "–")</td><td>@(person.FollowUp.Preference is { } p ? WorkPreferences.Labels.GetValueOrDefault(p) : "Ikke valgt")</td><td style="white-space:pre-wrap">@person.FollowUp.Note</td><td><button disabled="@busy" @onclick="() => Edit(person)">Rediger</button></td></tr>
        }</tbody>
    </table></div>
    @if (editing is not null)
    {
        <section aria-labelledby="edit-person">
            <h2 id="edit-person">@editing.Member.DisplayName</h2>
            <form @onsubmit="Save" @onsubmit:preventDefault>
                <fieldset disabled="@busy"><legend>Arbeid og sparing</legend>
                    <label style="display:block"><input type="checkbox" @bind="excludedFromCampaign" /> Teller ikke med i aksjonen</label>
                    <InputRadioGroup @bind-Value="preference">
                        <label style="display:block"><InputRadio Value="@((WorkPreference?)null)" /> Ikke valgt</label>
                        @foreach (var option in WorkPreferences.Labels)
                        {
                            <label style="display:block"><InputRadio Value="@((WorkPreference?)option.Key)" /> @option.Value</label>
                        }
                    </InputRadioGroup>
                    <label style="display:block" for="person-note">Notat (maks. 5000 tegn)</label>
                    <textarea id="person-note" @bind="note" maxlength="5000" rows="5" style="width:100%"></textarea>
                    <button type="submit" class="primary">Lagre</button>
                    <button type="button" @onclick="() => editing = null">Avbryt</button>
                </fieldset>
            </form>
        </section>
    }
}
@if (saved is not null) { <p role="status">@saved</p> }
@code {
    IReadOnlyList<PersonOverview>? people;
    PersonOverview? editing;
    string search = "", note = "";
    string? error, saved;
    WorkPreference? preference;
    bool busy, excludedFromCampaign;
    IEnumerable<PersonOverview> Matching => (people ?? []).Where(p => string.IsNullOrWhiteSpace(search) || p.Member.DisplayName.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) || p.Member.Id.ToString().Contains(search.Trim()));
    PersonSort sort = PersonSort.Name;
    bool descending;
    enum PersonSort { Name, TotalTarget, TotalContribution, SamvirkGetOnTrack }
    decimal? Value(PersonOverview person) => sort switch
    {
        PersonSort.TotalTarget => person.TotalTarget,
        PersonSort.TotalContribution => person.TotalContribution,
        PersonSort.SamvirkGetOnTrack => person.SamvirkGetOnTrack,
        _ => null
    };
    IEnumerable<PersonOverview> Filtered
    {
        get
        {
            if (sort == PersonSort.Name) return descending ? Matching.OrderByDescending(p => p.Member.DisplayName).ThenBy(p => p.Member.Id)
                : Matching.OrderBy(p => p.Member.DisplayName).ThenBy(p => p.Member.Id);
            var knownFirst = Matching.OrderBy(p => Value(p) is null);
            var ordered = descending ? knownFirst.ThenByDescending(Value) : knownFirst.ThenBy(Value);
            return ordered.ThenBy(p => p.Member.DisplayName).ThenBy(p => p.Member.Id);
        }
    }
    void SortBy(PersonSort column)
    {
        if (sort == column) descending = !descending;
        else { sort = column; descending = column != PersonSort.Name; }
    }
    string SortDirection(PersonSort column) => sort != column ? "none" : descending ? "descending" : "ascending";
    string SortArrow(PersonSort column) => sort != column ? "↕" : descending ? "↓" : "↑";
    static string Money(decimal? amount) => amount?.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("nb-NO")) ?? "–";
    protected override async Task OnInitializedAsync()
    {
        try { people = await Service.GetAllAsync(); }
        catch (GroupException ex) { error = ex.Message; }
        catch { error = "Personlisten kunne ikke hentes. Kontroller MyShare-tilgang og valgt klubb."; }
    }
    void Edit(PersonOverview person) { editing = person; note = person.FollowUp.Note; excludedFromCampaign = person.FollowUp.ExcludedFromCampaign; preference = person.FollowUp.Preference; saved = null; error = null; }
    async Task Save()
    {
        if (editing is null) return;
        busy = true; error = null; saved = null;
        try
        {
            await Service.SaveAsync(editing.Member.Id, note, preference, excludedFromCampaign: excludedFromCampaign);
            editing.FollowUp.ExcludedFromCampaign = excludedFromCampaign; editing.FollowUp.Note = note.Trim(); editing.FollowUp.Preference = preference;
            saved = $"Lagret for {editing.Member.DisplayName}."; editing = null;
        }
        catch (GroupException ex) { error = ex.Message; }
        catch { error = "Endringen kunne ikke lagres. Prøv igjen."; }
        finally { busy = false; }
    }
}
