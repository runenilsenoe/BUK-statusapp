@page "/pot"
@page "/oversikt"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using BukStatus.Core.Pot
@inject PotService PotService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Pot> Logger

<PageTitle>Oversikt · BUK Status</PageTitle>

<div class="pot @(bigScreen ? "pot-big" : "")">
    <div class="page-header">
        <h1>Oversikt@(screen is null ? "" : $": {screen.Source.Name}")</h1>
        <div class="actions">
            <select @bind="sourceKey" @bind:after="SourceChanged" aria-label="Hvem skjermen gjelder" disabled="@savingAjour">
                @foreach (var source in sources)
                {
                    <option value="@source.Key">@source.Name</option>
                }
            </select>
            <button type="button" @onclick="ToggleBigScreen">@(bigScreen ? "Avslutt storskjerm" : "Storskjerm")</button>
            @if (!bigScreen)
            {
                <a class="button" href="settings/oversikt">Innstillinger</a>
            }
        </div>
    </div>

    @if (error is not null)
    {
        <p class="alert">@error</p>
    }

    @if (!bigScreen)
    {
        <section class="pot-controls">
            <label>
                <span>BUK ajourgrense (%)</span>
                <input type="number" min="0" max="100" step="any" @bind="ajourOverride" @bind:after="SaveAjour" placeholder="Automatisk" disabled="@(loading || savingAjour)" />
            </label>
            <label class="pot-check"><input type="checkbox" @bind="sound" /> Lyd når noen blir ajour</label>
            <button type="button" @onclick="Load" disabled="@(loading || savingAjour)">Oppdater nå</button>
        </section>
    }

    @if (screen is null)
    {
        <p class="muted">Henter status …</p>
    }
    else
    {
        <PotBoard Screen="screen" LastLoaded="lastLoaded" />
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "kilde")] public string? Kilde { get; set; }

    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(5);

    private List<PotSource> sources = [];
    private string sourceKey = PotSource.AllTeamsKey;
    private PotScreen? screen;
    private decimal? ajourOverride;
    private bool savingAjour;
    private bool sound;
    private bool bigScreen;
    private bool loading;
    private string? error;
    private DateTime? lastLoaded;

    // A change of threshold must not trigger the ajour sound.
    private (string Source, decimal? Threshold)? previousView;
    private int? previousAjourCount;

    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;
    private IJSObjectReference? module;

    protected override async Task OnInitializedAsync()
    {
        sourceKey = Kilde ?? PotSource.AllTeamsKey;
        try
        {
            sources = await PotService.GetSourcesAsync();
        }
        catch (Exception ex)
        {
            error = $"Klarte ikke å hente lag og grupper: {ex.Message}";
        }
        await Load();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _ = AutoRefresh();
    }

    private async Task AutoRefresh()
    {
        cts = new CancellationTokenSource();
        timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cts.Token))
                if (!savingAjour) await InvokeAsync(Load);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task Load()
    {
        if (loading)
            return;
        loading = true;
        try
        {
            screen = await PotService.GetScreenAsync(sourceKey, 0, PotStrategy.Even);
            ajourOverride = screen.Settings.BukAjourPercentOverride;
            sourceKey = screen.Source.Key;
            lastLoaded = DateTime.Now;
            error = null;
            await PlaySoundIfNewAjour(screen);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load the pot screen");
            error = $"Klarte ikke å hente status: {ex.Message}";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task PlaySoundIfNewAjour(PotScreen loaded)
    {
        var view = (loaded.Source.Key, loaded.Settings.BukAjourPercentOverride);
        var count = loaded.Result.OnTrackWithPotCount;
        var sameView = previousView == view;
        var more = previousAjourCount is { } before && count > before;
        previousView = view;
        previousAjourCount = count;

        if (sound && sameView && more)
        {
            try
            {
                module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./pot/pot.js");
                await module.InvokeVoidAsync("playSound", "pot/ny-ajour.mp3");
            }
            catch (JSException ex)
            {
                Logger.LogDebug(ex, "Could not play sound");
            }
        }
    }

    private async Task SourceChanged()
    {
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("kilde", sourceKey), replace: true);
        await Load();
    }

    private async Task SaveAjour()
    {
        savingAjour = true;
        try
        {
            await PotService.SaveAjourPercentAsync(ajourOverride);
            await Load();
        }
        catch (Exception ex)
        {
            error = $"Kunne ikke lagre ajourgrensen: {ex.Message}";
        }
        finally
        {
            savingAjour = false;
        }
    }

    private async Task ToggleBigScreen()
    {
        bigScreen = !bigScreen;
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./pot/pot.js");
            await module.InvokeVoidAsync("setFullscreen", bigScreen);
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Could not toggle fullscreen");
        }
    }

    public async ValueTask DisposeAsync()
    {
        cts?.Cancel();
        timer?.Dispose();
        cts?.Dispose();
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
