@page "/administrators"
@rendermode InteractiveServer
@using BukStatus.Core.Administration
@inject BukStatus.Web.Auth.AdministratorAccess Access
@inject Microsoft.Extensions.Options.IOptions<BukStatus.Web.Notifications.SmtpOptions> Smtp

<PageTitle>Administratorer · BUK Status</PageTitle>
<h1>Administratorer</h1>
@if (saved is not null) { <p role="status">@saved</p> }
@if (error is not null)
{
    <p class="alert">@error</p>
}
@if (administrators is not null)
{
    @if (pending.Count > 0)
    {
        <section class="alert" aria-label="Tilgangsforespørsler"><h2>Tilgangsforespørsler (@pending.Count)</h2>
        @foreach (var request in pending)
        {
            <p><strong>@request.DisplayName</strong> · @request.PersonId · @request.RequestedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
            <button type="button" disabled="@busy" @onclick="() => Run(() => Access.ApproveAsync(request.PersonId))">Legg til ny admin</button><br />
            <small>@(request.NotifiedAtUtc is not null ? "E-postvarsel sendt" : request.DeliveryError ?? "E-postvarsel venter på utsending/oppsett")</small></p>
        }</section>
    }
    <button type="button" disabled="@busy" @onclick="() => Run(() => Task.CompletedTask)">Oppdater forespørsler</button>
    <h2>E-postvarsler</h2>
    <form @onsubmit="() => Run(() => Access.SaveRecipientAsync(recipient))" @onsubmit:preventDefault>
        <label>Mottaker <input type="email" @bind="recipient" maxlength="254" required disabled="@busy" /></label>
        <button disabled="@busy" type="submit">Lagre mottaker</button>
    </form>
    @if (!Smtp.Value.Configured) { <p class="alert">Gmail SMTP er ikke ferdig konfigurert. Forespørsler lagres og vises her; e-post sendes når SMTP og mottaker er satt opp.</p> }
    <p>Person-ID <strong>21410</strong> er fast superadministrator og kan ikke fjernes.</p>
    <p>Administratorer kan endre lag, grupper og innstillinger i klubbene de har tilgang til i MyShare.</p>
    <form class="inline-form" @onsubmit="Add">
        <label>BCC person-ID <input type="number" min="1" @bind="personId" required /></label>
        <label>Navn (valgfritt) <input @bind="name" maxlength="200" /></label>
        <button type="submit" class="primary" disabled="@busy">Legg til administrator</button>
    </form>
    @if (administrators.Count == 0)
    {
        <p class="muted">Ingen andre administratorer er lagt til.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Navn</th><th>Person-ID</th><th></th></tr></thead>
            <tbody>
            @foreach (var admin in administrators)
            {
                <tr><td>@(admin.DisplayName ?? "–")</td><td>@admin.PersonId</td>
                    <td><button type="button" disabled="@busy" @onclick="() => Remove(admin.PersonId)">Fjern administrator</button></td></tr>
            }
            </tbody>
        </table>
    }
}
@code {
    private List<Administrator>? administrators;
    private List<AccessRequest> pending = [];
    private string recipient = "";
    private int? personId;
    private string? name;
    private string? error, saved;
    private bool busy;
    protected override async Task OnInitializedAsync()
    {
        try { administrators = await Access.GetAllAsync(); pending = await Access.GetPendingAsync(); recipient = await Access.GetRecipientAsync(); }
        catch (UnauthorizedAccessException) { error = "Kun superadministratoren har tilgang til denne siden."; }
    }
    private Task Add() => Run(async () =>
    {
        if (personId is not > 0) throw new GroupException("Fyll inn en gyldig BCC person-ID.");
        await Access.AddAsync(personId.Value, name);
        personId = null;
        name = null;
    });
    private Task Remove(int id) => Run(() => Access.RemoveAsync(id));
    private async Task Run(Func<Task> action)
    {
        busy = true;
        error = null; saved = null;
        try { await action(); administrators = await Access.GetAllAsync(); pending = await Access.GetPendingAsync(); recipient = await Access.GetRecipientAsync(); saved = "Oppdatert."; }
        catch (UnauthorizedAccessException) { administrators = null; error = "Kun superadministratoren kan endre administratorer."; }
        catch (GroupException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
