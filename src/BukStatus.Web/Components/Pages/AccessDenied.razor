@page "/access-denied"
@attribute [AllowAnonymous]
@using System.Security.Claims
@using BukStatus.Web.Auth

<PageTitle>Ingen tilgang · BUK Status</PageTitle>

<h1>Ingen tilgang</h1>

@if (personId is not null)
{
    <p>Du er logget inn som <strong>@name</strong> (person-ID @personId), men har ikke tilgang til BUK Status.</p>
    @if (Requested) { <p role="status">Tilgangsforespørselen er registrert. En administrator må godkjenne den før du får tilgang. Du kan prøve igjen etter godkjenning.</p><a href="/">Prøv tilgang igjen</a> }
    else
    {
        <p>Be om tilgang for å sende en forespørsel til administratoren.</p>
        <form method="post" action="account/request-access"><AntiforgeryToken /><button type="submit">Be om tilgang</button></form>
    }
}
else if (signedIn)
{
    <p>Du er logget inn@(name is null ? "" : $" som {name}"), men innloggingen fra BCC inneholdt ingen person-ID, så vi kan ikke sjekke tilgangen din.</p>
    <p class="muted">Gi beskjed til en administrator. BCC-login må sende kravet @BukClaims.PersonId.</p>
}
else
{
    <p>Du har ikke tilgang til denne siden.</p>
}

<form method="post" action="account/logout">
    <AntiforgeryToken />
    <button type="submit">Logg ut</button>
</form>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromQuery(Name = "requested")] public bool Requested { get; set; }
    private int? personId;
    private string? name;
    private bool signedIn;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
            return;
        var user = (await AuthState).User;
        signedIn = user.Identity?.IsAuthenticated == true;
        personId = user.PersonId();
        name = user.Identity?.Name ?? user.FindFirst(ClaimTypes.Email)?.Value;
    }
}
