@page "/settings/pot"
@page "/settings/oversikt"
@rendermode InteractiveServer
@using BukStatus.Core.Pot
@inject PotService PotService
@inject BukStatus.Core.Clubs.IClubContext Clubs

<PageTitle>Innstillinger for oversikt · BUK Status</PageTitle>

<p><a href="oversikt">← Oversikt</a></p>

<div class="page-header">
    <h1>Innstillinger for oversikt</h1>
</div>

@if (error is not null)
{
    <p class="alert">@error</p>
}

@if (settings is not null)
{
    <form @onsubmit="Save">
        <h2 class="form-section">Skjerm</h2>
        <div class="form-grid">
            <label>
                Overskrift for samlet score
                <input @bind="settings.Title" maxlength="100" placeholder="f.eks. SØRLANDET" />
            </label>
            <label>
                Undertekst (valgfritt)
                <input @bind="settings.Subtitle" maxlength="200" placeholder="f.eks. sorlandet.donationbuk.no" />
            </label>
            <label>
                Samvirk uten import (%)
                <input type="number" min="0" max="100" step="any" @bind="settings.SamvirkPercent" />
            </label>
            <label>
                Milepæl 1 (%)
                <input type="number" min="0.01" max="100" step="any" @bind="milestone1" />
            </label>
            <label>
                Milepæl 2 (%)
                <input type="number" min="0.01" max="100" step="any" @bind="milestone2" />
            </label>
        </div>
        @if (Clubs.Enabled)
        {
            <p class="muted">Storskjerm krever innlogging og tilgang til klubben. Bruk «Storskjerm» på Oversikt-siden.</p>
        }
        else
        {
        <label class="check-row">
            <input type="checkbox" @bind="settings.PublicScreenEnabled" />
            Åpen storskjerm uten innlogging på <a href="skjerm" target="_blank">/skjerm</a>
        </label>
        <p class="muted small" style="max-width: 760px;">
            Den åpne skjermen viser totaler og stolper uten navn eller beløp per person, og oppdateres hvert 30. sekund.
            Alle som har lenken kan se den. Velg utvalg med <code>?kilde=lag-1</code> eller <code>?kilde=gruppe-1</code>,
            og <code>?fordeling=flest</code> for «Flest mulig ajour».
        </p>

        }

        <h2 class="form-section">Ekstrabidrag</h2>
        <div class="form-grid">
            <label>Fra dato <input type="date" @bind="settings.ExtraFrom" /></label>
            <label>Til dato <input type="date" @bind="settings.ExtraTo" /></label>
        </div>

        <div class="toolbar">
            <button type="submit" class="primary" disabled="@busy">Lagre</button>
            @if (saved)
            {
                <span class="muted">Lagret.</span>
            }
        </div>

    </form>

    <h2 class="form-section">Simulering</h2>
    <section class="pot-controls">
        <label>
            Utvalg
            <select @bind="simulationSource" @bind:after="Simulate">
                @foreach (var source in simulationSources)
                {
                    <option value="@source.Key">@source.Name</option>
                }
            </select>
        </label>
        <label class="pot-slider">
            <span>Simuler ekstra pott</span>
            <input type="range" min="0" max="@SliderMax" step="@SliderStep" @bind="simulated" @bind:after="Simulate" />
        </label>
        <label>
            <span>Simulert beløp</span>
            <input type="number" min="0" step="100" @bind="simulated" @bind:after="Simulate" />
        </label>
        <fieldset class="pot-strategy">
            <legend>Fordeling</legend>
            <label><input type="radio" name="strategy" checked="@(strategy == PotStrategy.Even)" @onchange="() => SetStrategy(PotStrategy.Even)" /> Likt på alle som ikke er ajour</label>
            <label><input type="radio" name="strategy" checked="@(strategy == PotStrategy.MaximizeAjour)" @onchange="() => SetStrategy(PotStrategy.MaximizeAjour)" /> Flest mulig ajour</label>
        </fieldset>
        <button type="button" @onclick="Simulate" disabled="@simulating">Vis simulering</button>
    </section>
    @if (simulationError is not null) { <p class="alert">@simulationError</p> }
    @if (simulation is not null) { <PotBoard Screen="simulation" /> }

}

@code {
    private PotSettings? settings;
    private string? error;
    private bool busy;
    private bool saved;
    private decimal? milestone1;
    private decimal? milestone2;
    private List<PotSource> simulationSources = [];
    private string simulationSource = PotSource.AllTeamsKey;
    private decimal simulated;
    private PotStrategy strategy;
    private PotScreen? simulation;
    private bool simulating;
    private string? simulationError;
    private decimal SliderMax => Math.Max(Math.Max(10000, simulated), Math.Ceiling((simulation?.Result.RemainingBeforePot ?? 0) / 10000) * 10000);
    private decimal SliderStep => SliderMax > 200000 ? 5000 : 1000;

    protected override async Task OnInitializedAsync()
    {
        settings = await PotService.GetSettingsAsync();
        var milestones = settings.MilestoneList.Select(v => (decimal?)v).ToArray();
        milestone1 = milestones.ElementAtOrDefault(0);
        milestone2 = milestones.ElementAtOrDefault(1);
        simulationSources = await PotService.GetSourcesAsync();
    }

    private async Task Save()
    {
        if (settings is null)
            return;
        busy = true;
        error = null;
        saved = false;
        try
        {
            settings.Milestones = string.Join(';', new[] { milestone1, milestone2 }
                .Where(v => v.HasValue).Select(v => v!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)));
            settings.BukAjourPercentOverride = (await PotService.GetSettingsAsync()).BukAjourPercentOverride;
            await PotService.SaveSettingsAsync(settings);
            saved = true;
            if (simulation is not null) await Simulate();
        }
        catch (GroupException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SetStrategy(PotStrategy value)
    {
        strategy = value;
        await Simulate();
    }

    private async Task Simulate()
    {
        if (simulating) return;
        simulating = true;
        simulationError = null;
        try
        {
            simulated = Math.Max(0, simulated);
            simulation = await PotService.GetScreenAsync(simulationSource, simulated, strategy);
        }
        catch (Exception ex)
        {
            simulationError = $"Kunne ikke simulere: {ex.Message}";
        }
        finally { simulating = false; }
    }

}
