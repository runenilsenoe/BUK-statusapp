@inject BukStatus.Core.Clubs.IClubContext ClubAccess
@using BukStatus.Web.Auth
@inherits LayoutComponentBase

<header class="topbar">
    <div class="nav">
        <a href="/" class="brand">BUK Status</a>
        <AuthorizeView>
            <Authorized>
                <nav>
                    @if (ClubAccess.Enabled) { <NavLink href="clubs">Klubber</NavLink> }
                    <NavLink href="/" Match="NavLinkMatch.All">Grupper</NavLink>
                    <NavLink href="teams">Lag</NavLink>
                    <NavLink href="report" Match="NavLinkMatch.All">Månedsrapport</NavLink>
                    <NavLink href="report/weeks">Ukerapport</NavLink>
                    <NavLink href="pot">Pott</NavLink>
                    <NavLink href="settings/targets">Månedsmål</NavLink>
                    @if (context.User.PersonId() == BukStatus.Core.Administration.AdministratorStore.SuperAdminPersonId)
                    {
                        <NavLink href="administrators">Administratorer</NavLink>
                        <NavLink href="diagnostics/bcc">API-test</NavLink>
                    }
                </nav>
            </Authorized>
        </AuthorizeView>
    </div>
    <AuthorizeView>
        <Authorized>
            <div class="user">
                <span class="muted">@context.User.Identity?.Name</span>
                <form method="post" action="account/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="link">Logg ut</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</header>

<main class="page">
    <AuthorizeView><Authorized><ClubSelection /></Authorized></AuthorizeView>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Det oppstod en feil.
    <a href="." class="reload">Last inn på nytt</a>
    <span class="dismiss">🗙</span>
</div>
