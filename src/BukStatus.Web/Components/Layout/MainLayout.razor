@inject BukStatus.Core.Clubs.IClubContext ClubAccess
@using BukStatus.Web.Auth
@inherits LayoutComponentBase

<header class="topbar">
    <div class="nav">
        <a href="/" class="brand">BUK Status</a>
        <AuthorizeView Policy="@AuthSetup.Policy">
            <Authorized>
                <HeroNavigation ShowClubs="ClubAccess.Enabled" IsSuperAdmin="@(context.User.PersonId() == BukStatus.Core.Administration.AdministratorStore.SuperAdminPersonId)" />
            </Authorized>
        </AuthorizeView>
    </div>
    <AuthorizeView>
        <Authorized>
            <div class="user">
                <span class="muted">@context.User.Identity?.Name</span>
                <form method="post" action="account/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="link">Logg ut</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</header>

<main class="page">
    <AuthorizeView Policy="@AuthSetup.Policy"><Authorized><ClubSelection /></Authorized></AuthorizeView>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Det oppstod en feil.
    <a href="." class="reload">Last inn på nytt</a>
    <span class="dismiss">🗙</span>
</div>
